{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist", "!!**/coverage", "!!**/reports", "!!**/playwright-report", "!!**/test-results"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noImportCycles": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/index.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../db/*", "!../db/tipos", "../pages/*", "../components/*", "../App", "../main"],
                    "message": "src/lib guarda regras puras: do banco, só ../db/tipos (tipos e constantes); sem React, Dexie, telas ou componentes. Hooks ficam em components/ ou db/."
                  }
                ],
                "paths": {
                  "react": "src/lib guarda regras puras: do banco, só ../db/tipos (tipos e constantes); sem React, Dexie, telas ou componentes. Hooks ficam em components/ ou db/.",
                  "react-dom": "src/lib guarda regras puras: do banco, só ../db/tipos (tipos e constantes); sem React, Dexie, telas ou componentes. Hooks ficam em components/ ou db/.",
                  "dexie": "src/lib guarda regras puras: do banco, só ../db/tipos (tipos e constantes); sem React, Dexie, telas ou componentes. Hooks ficam em components/ ou db/.",
                  "dexie-react-hooks": "src/lib guarda regras puras: do banco, só ../db/tipos (tipos e constantes); sem React, Dexie, telas ou componentes. Hooks ficam em components/ ou db/."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../pages/*", "../components/*", "../App", "../main"],
                    "message": "A camada de dados não conhece telas nem componentes."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../pages/*", "../App", "../main"],
                    "message": "Componentes são reutilizáveis: não importam telas."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./*"],
                    "message": "Uma tela não importa outra; o que for compartilhado vai para components/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
